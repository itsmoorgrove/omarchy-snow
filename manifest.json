{
  "schemaVersion": 1,
  "id": "local.snow",
  "name": "Snowfall",
  "version": "1.1.0",
  "author": "moorgrove",
  "license": "MIT",
  "description": "Quiet, layered snowfall and delicate snow along visible window edges.",
  "kinds": [
